# media and models never go into git. [mM][oO][vV] catches .MOV too: on macOS (core.ignorecase) it makes no
# difference, but on another system "RECORDING.MOV" would slip past "*.mov"
*.[mM][oO][vV]
*.[mM][pP]4
*.[mM]4[vV]
*.[mM][kK][vV]
*.[wW][eE][bB][mM]
*.[mM][tT][sS]
*.[wW][aA][vV]
# exception: short sound effects, generated by synthesis (src/vtk/sfx.py generate), a few KB
!/sfx/*.wav
*.[mM][pP]3
*.[mM]4[aA]
*.[aA][aA][cC]
*.[aA][iI][fF]
*.[aA][iI][fF][fF]
*.onnx
*.tar.bz2
models/

# images (covers, frames, candidate sheets) stay out; only those in presets/, assets/ and vendor/ go in
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
!/presets/**/*.[pP][nN][gG]
!/presets/**/*.[jJ][pP][gG]
!/presets/**/*.[jJ][pP][eE][gG]
!/assets/**/*.[pP][nN][gG]
!/assets/**/*.[jJ][pP][gG]
!/assets/**/*.[jJ][pP][eE][gG]
!/vendor/**/*.[pP][nN][gG]
!/vendor/**/*.[jJ][pP][gG]
!/vendor/**/*.[jJ][pP][eE][gG]

# intermediate outputs of the flow, in case they land outside videos/<name>/
render*/
work/
edited/
covers/
list.txt
sil.txt
segs.json
transcript.json
transcript.txt
!/vendor/**/transcript.*
*.bak

.DS_Store
__pycache__/

# the author's personal context (folders, audience, content decisions)
CLAUDE.local.md

# each video's content (transcript, cuts, metadata, covers, render) stays local: the repo is public
videos/

# the project's local Python environment (sherpa-onnx, numpy, Pillow, mediapipe)
.venv/
